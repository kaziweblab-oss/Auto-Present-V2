# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
MONGODB_URL=mongodb+srv://<username>:<password>@cluster.mongodb.net/auto_present_v1?retryWrites=true&w=majority

# Authentication & Security
JWT_SECRET=your_super_secret_jwt_key_here
ADMINE_EMAILS=your-admin-email@example.com
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://127.0.0.1:5000/api/auth/google/callback

# Frontend URL (CORS-এর জন্য প্রয়োজন হবে)
CLIENT_URL=http://localhost:5173