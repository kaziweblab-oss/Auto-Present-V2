{
  "name": "auto-present-v2",
  "version": "2.0.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/shared",
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "npm run dev --workspace @auto-present-v2/api",
    "dev:web": "npm run dev --workspace @auto-present-v2/web",
    "start": "npm run start --workspace @auto-present-v2/api",
    "build": "npm run build --workspaces --if-present",
    "build:render": "npm run build --workspace @auto-present-v2/shared && npm run build --workspace @auto-present-v2/api && npm run build --workspace @auto-present-v2/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "concurrently": "^9.2.0",
    "prettier": "^3.3.3",
    "typescript": "^5.9.2"
  }
}
